{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend_app/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "Backend_app/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
