{
  "name": "oceangate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "cd Backend_app && node index.js",
    "build": "npm run install:all && npm run build:frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run backend\" \"npm run frontend\"",
    "start:tunnel": "concurrently -n \"SERVER,TUNNEL\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run backend\" \"npm run tunnel\"",
    "build:frontend": "cd frontend_app && npm run build",
    "tunnel": "node tunnel.js",
    "backend": "cd Backend_app && npm start",
    "frontend": "cd frontend_app && npm run dev",
    "install:all": "cd Backend_app && npm install && cd ../frontend_app && npm install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "concurrently": "^10.0.5",
    "localtunnel": "^2.0.2"
  }
}
